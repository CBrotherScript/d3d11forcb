// Render3DCatch.cb — CBrother 版 Render3DCatch 类
// 对应 d3dcdemo/Render3DCatch.h / Render3DCatch.cpp
//
// 说明：
//   * 维护一个全局常量缓冲 m_GlobeBuffers（VS 阶段 slot0），存放 view + proj 两个矩阵。
//   * 矩阵上传模式与 SceneObject.Render 一致：glm::Mat4.array() → CLibArrayData.setFloat() → UpdateSubresource。
//   * C++ 的两个 UpdateGlobalUBO 重载（View3D* / Light*）：CBrother 不支持函数重载，
//     拆成 UpdateGlobalUBO_View 与 UpdateGlobalUBO_Light。
//   * CullFace / DepthLessEqual / DepthLess：设置对应的光栅化 / 深度模板状态。

import lib/glm.cb

class Render3DCatch
{
    var m_GlobeBuffers  = null;   // ID3D11Buffer*（常量缓冲，128 字节 = view(64B) + proj(64B)）
    //var m_pGlobeBuffers = null;   // ID3D11Buffer**（绑定用）
    var m_CBData        = null;   // CLibArrayData —— 32 个 float（两个 4x4 矩阵，用于 UpdateSubresource）

    // ===== 初始化时一次性创建的渲染状态（对应 C++ 在 init 时建好、过程中直接复用）=====
    var m_RSCullFront = null;     // 光栅化：正面剔除（正向渲染）
    var m_RSCullNone  = null;     // 光栅化：关闭剔除（全屏 quad）
    var m_DSLessEqual = null;     // 深度模板：深度比较 <=
    var m_DSLess      = null;     // 深度模板：深度比较 <

    function Render3DCatch()
    {
        // 常量缓冲：128 字节 = 2 个 float4x4（view + proj），与 SceneObject 一样用 DEFAULT 创建
        var cbd = new D3D11_BUFFER_DESC(128, D3D11_BIND_CONSTANT_BUFFER);
        m_GlobeBuffers = g_d3d.m_Device.CreateBuffer(cbd, null);

        g_d3d.m_Context.VSSetConstantBuffers(0, 1, m_GlobeBuffers.GetAddressOf());

        // 更新数据容器：32 个 float = view(16) + proj(16)
        m_CBData = new CLibArrayData(new CLibArray("float", 32));

        // 一次性创建渲染状态（与 C++ 一致：初始化时创建，渲染过程中直接设置复用）
        m_RSCullFront = _createRasterizer(D3D11_CULL_FRONT);
        m_RSCullNone  = _createRasterizer(D3D11_CULL_NONE);
        m_DSLessEqual = _createDepthStencil(D3D11_COMPARISON_LESS_EQUAL);
        m_DSLess      = _createDepthStencil(D3D11_COMPARISON_LESS);
    }

    // 创建光栅化状态（FillMode=Solid，其余取与 C++ 一致的默认设置）
    function _createRasterizer(cullMode)
    {
        var rdesc = new D3D11_RASTERIZER_DESC();
        rdesc.SetFillMode(D3D11_FILL_SOLID);
        rdesc.SetCullMode(cullMode);
        rdesc.SetFrontCounterClockwise(0);
        rdesc.SetDepthBias(0);
        rdesc.SetDepthBiasClamp(0.0);
        rdesc.SetSlopeScaledDepthBias(0.0);
        rdesc.SetDepthClipEnable(1);
        rdesc.SetScissorEnable(0);
        rdesc.SetMultisampleEnable(0);
        rdesc.SetAntialiasedLineEnable(0);
        return g_d3d.m_Device.CreateRasterizerState(rdesc);
    }

    // 创建深度模板状态（开启深度写入，关闭模板）
    function _createDepthStencil(depthFunc)
    {
        var ddesc = new D3D11_DEPTH_STENCIL_DESC();
        ddesc.SetDepthEnable(1);
        ddesc.SetDepthWriteMask(D3D11_DEPTH_WRITE_MASK_ALL);
        ddesc.SetDepthFunc(depthFunc);
        ddesc.SetStencilEnable(0);
        return g_d3d.m_Device.CreateDepthStencilState(ddesc);
    }

    // 统一的上传函数：将当前 m_CBData 写入常量缓冲
    function _uploadCB()
    {
        g_d3d.m_Context.UpdateSubresource(m_GlobeBuffers, 0, null, m_CBData.addr(), 0, 0);
    }

    // ===== 对应 C++ UpdateGlobalUBO(View3D* v) =====
    function UpdateGlobalUBO_View(v)
    {
        var camera = v.GetCamera();
        var aspect = v.m_AspectRatio / camera.Zoom;
        // glm::Mat4 列主序字节与 HLSL float4x4 常量缓冲一致，直接取 .array() 上传
        var viewMat = camera.GetViewMatrix();
        var projMat = glm::perspective(glm::radians(camera.Zoom), v.m_AspectRatio, 0.1, 200.0);

        var viewA = viewMat.array();   // 16 个 float，列主序
        var projA = projMat.array();   // 16 个 float，列主序
        for (var i = 0; i < 16; i++)
        {
            m_CBData.setFloat(i,      viewA[i]);    // slots 0~15: view
            m_CBData.setFloat(16 + i, projA[i]);    // slots 16~31: proj
        }

        g_d3d.m_Context.VSSetConstantBuffers(0, 1, m_GlobeBuffers.GetAddressOf());
        _uploadCB();
    }

    // ===== 对应 C++ UpdateGlobalUBO(Light* l)（实际传入 DirectionLight）=====
    function UpdateGlobalUBO_Light(l)
    {
        // C++: DirectionLight* dlight = static_cast<DirectionLight*>(l);
        //      使用 dlight 预计算的光源视锥矩阵（构造时由 ortho/lookAt 生成）。
        var viewA = l.m_LightView.array();
        var projA = l.m_LightProjection.array();
        for (var i = 0; i < 16; i++)
        {
            m_CBData.setFloat(i,      viewA[i]);    // slots 0~15: 光源 view
            m_CBData.setFloat(16 + i, projA[i]);    // slots 16~31: 光源 proj
        }

        g_d3d.m_Context.VSSetConstantBuffers(0, 1, m_GlobeBuffers.GetAddressOf());
        _uploadCB();
    }

    // ===== 对应 C++ CullFace(bool enable)：开启/关闭正面剔除 =====
    function CullFace(enable)
    {
        if (enable)
            g_d3d.m_Context.RSSetState(m_RSCullFront);   // 正向渲染：剔除正面
        else
            g_d3d.m_Context.RSSetState(m_RSCullNone);     // 全屏 quad 等：关闭剔除
    }

    // ===== 对应 C++ DepthLessEqual() =====
    function DepthLessEqual()
    {
        g_d3d.m_Context.OMSetDepthStencilState(m_DSLessEqual, 0);
    }

    // ===== 对应 C++ DepthLess() =====
    function DepthLess()
    {
        g_d3d.m_Context.OMSetDepthStencilState(m_DSLess, 0);
    }
}
